# Copy this file to .env and fill in your keys. .env is git-ignored.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# MongoDB Atlas connection string (Atlas > Connect > Drivers), and database name
MONGODB_URI=
MONGODB_DATABASE=frienddex

# Code people need to create an account. Leave empty to close sign-up.
FRIENDDEX_INVITE_CODE=
