@page "/login"
@inject AppSettings Settings
@inject HttpAccountClient Accounts
@inject NavigationManager Nav

<PageTitle>Log in · FriendDex</PageTitle>

<section class="win">
    <h1 class="win-title">@(creating ? "Create an account" : "Log in")</h1>

    <div class="field">
        <label for="email">Email</label>
        <input id="email" class="px-input" type="email" @bind="email" autocomplete="username" />
    </div>
    <div class="field">
        <label for="password">Password@(creating ? " (at least 8 characters)" : "")</label>
        <input id="password" class="px-input" type="password" @bind="password" autocomplete="@(creating ? "new-password" : "current-password")" />
    </div>
    @if (creating)
    {
        <div class="field">
            <label for="invite">Invite code</label>
            <input id="invite" class="px-input" @bind="invite" autocomplete="off" />
        </div>
    }

    @if (showServer)
    {
        <div class="field">
            <label for="url">Server address</label>
            <input id="url" class="px-input" @bind="url" inputmode="url" autocomplete="off"
                   placeholder="@AppSettings.DefaultServerUrl" />
        </div>
    }

    <div class="btn-row">
        <button class="px-btn px-btn-leaf" @onclick="SubmitAsync" disabled="@busy">
            @(busy ? "One moment…" : creating ? "Create account" : "Log in")
        </button>
        <button class="text-btn" @onclick="() => { creating = !creating; error = null; }">
            @(creating ? "I already have an account" : "Create an account")
        </button>
    </div>

    @if (error != null) { <p class="error-text" role="alert">@error</p> }

    @if (!showServer)
    {
        <p class="muted small server-note">
            Server: @AppSettings.Normalize(url)
            <button class="text-btn" @onclick="() => showServer = true">Use a different server</button>
        </p>
    }
</section>

@code {
    private string url = "";
    private string email = "";
    private string password = "";
    private string invite = "";
    private bool creating;
    private bool showServer;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Settings.LoadAsync();
        url = Settings.ServerUrl;
        // Only show the address box when someone has switched away from the default server.
        showServer = url != AppSettings.DefaultServerUrl;
    }

    private async Task SubmitAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(url)) url = AppSettings.DefaultServerUrl;
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Fill in your email and password.";
            return;
        }
        if (creating && string.IsNullOrWhiteSpace(invite))
        {
            error = "Enter the invite code.";
            return;
        }

        busy = true;
        var server = AppSettings.Normalize(url);
        try
        {
            var result = creating
                ? await Accounts.RegisterAsync(server, email, password, invite)
                : await Accounts.LoginAsync(server, email, password);
            await Settings.SaveLoginAsync(server, result.Email, result.Token);
            password = "";
            Nav.NavigateTo("/friends");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
