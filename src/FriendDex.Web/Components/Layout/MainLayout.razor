@inherits LayoutComponentBase

<div class="game">
    <header class="topbar">
        <a class="logo" href="/friends">FriendDex</a>
        <div class="topbar-actions">
            <a class="px-btn px-btn-sun" href="/friends/new">+ New friend</a>
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/logout" class="logout">
                        <span class="who">@context.User.Identity?.Name</span>
                        <button type="submit" class="text-btn">Log out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="stage">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
