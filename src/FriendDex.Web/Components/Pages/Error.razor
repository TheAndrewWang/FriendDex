@page "/Error"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Diagnostics

<PageTitle>Something went wrong · FriendDex</PageTitle>

<section class="win" style="max-width: 34rem">
    <h1 class="win-title">Something went wrong</h1>
    <p>FriendDex hit a problem handling that request. Try again in a moment.</p>
    <p class="muted small">If it keeps happening, open <a href="/health">/health</a> to check whether the server can reach its database.</p>
    @if (!string.IsNullOrEmpty(RequestId))
    {
        <p class="muted small">Request ID: <code>@RequestId</code></p>
    }
    <a class="px-btn px-btn-sun" href="/friends">Back to friends</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
