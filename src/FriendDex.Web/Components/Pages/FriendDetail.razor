@page "/friends/{Id:int}"
@rendermode InteractiveServer
@using FriendDex.Web.Data
@using FriendDex.Web.Domain
@using FriendDex.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> Factory
@inject NavigationManager Nav
@inject FriendNoteAgent Agent
@inject ChibiGenerator ChibiAi

@if (notFound)
{
    <PageTitle>Not found</PageTitle>
    <p>That friend doesn't exist.</p>
    <a href="/friends">Back to friends</a>
    return;
}
@if (friend == null)
{
    <p>Loading...</p>
    return;
}

<PageTitle>@friend.Name</PageTitle>

<div class="d-flex flex-wrap gap-4 align-items-start mb-4">
    <div class="text-center">
        @if (friend.Avatar != null)
        {
            <img src="/friends/@friend.Id/avatar?v=@friend.AvatarGeneratedAt?.Ticks" alt="Chibi of @friend.Name"
                 width="220" height="220" class="rounded" style="object-fit: contain; image-rendering: pixelated" />
        }
        else
        {
            <Chibi Friend="friend" Size="220" />
        }
        <div class="mt-2">
            <button class="btn btn-sm btn-primary" @onclick="GenerateChibiAsync" disabled="@generating">
                @(generating ? "Drawing..." : friend.Avatar == null ? "Generate chibi ✨" : "Regenerate")
            </button>
            @if (friend.Avatar != null && !generating)
            {
                <button class="btn btn-sm btn-link" @onclick="ClearAvatarAsync">Use drawn version</button>
            }
        </div>
        @if (generating)
        {
            <div class="text-muted small mt-1">This can take up to a minute.</div>
        }
        @if (chibiError != null)
        {
            <div class="text-danger small mt-1" style="max-width: 16rem">@chibiError</div>
        }
        <div class="mt-2">
            <label class="btn btn-sm btn-outline-secondary mb-0">
                @(friend.Photo == null ? "Upload photo" : "Change photo")
                <InputFile OnChange="UploadPhotoAsync" accept="image/png,image/jpeg,image/webp,image/gif" class="d-none" />
            </label>
            @if (friend.Photo != null)
            {
                <button class="btn btn-sm btn-link" @onclick="RemovePhotoAsync">Remove</button>
            }
        </div>
        @if (photoError != null)
        {
            <div class="text-danger small mt-1">@photoError</div>
        }
    </div>

    <div class="flex-grow-1">
        <h1>@friend.Name</h1>
        <dl class="row mb-3" style="max-width: 28rem">
            <dt class="col-5">Age</dt>
            <dd class="col-7">@(AgeCalculator.GetAge(friend.Birthday, today)?.ToString() ?? "—")</dd>
            <dt class="col-5">Birthday</dt>
            <dd class="col-7">@(friend.Birthday?.ToString("MMM d, yyyy") ?? "—")</dd>
            <dt class="col-5">Next birthday</dt>
            <dd class="col-7">@(AgeCalculator.NextBirthday(friend.Birthday, today)?.ToString("MMM d, yyyy") ?? "—")</dd>
            <dt class="col-5">Gender</dt>
            <dd class="col-7">@(string.IsNullOrWhiteSpace(friend.Gender) ? "—" : friend.Gender)</dd>
            <dt class="col-5">Favorite color</dt>
            <dd class="col-7">@(friend.FavoriteColor ?? "—")</dd>
        </dl>
        <a class="btn btn-outline-primary btn-sm" href="/friends/@friend.Id/edit">Edit details</a>
        @if (confirmDelete)
        {
            <span class="ms-2">Delete @friend.Name and all their interests?</span>
            <button class="btn btn-danger btn-sm ms-1" @onclick="DeleteFriendAsync">Yes, delete</button>
            <button class="btn btn-secondary btn-sm ms-1" @onclick="() => confirmDelete = false">Cancel</button>
        }
        else
        {
            <button class="btn btn-outline-danger btn-sm ms-2" @onclick="() => confirmDelete = true">Delete friend</button>
        }
    </div>
</div>

@* ---------- AI note box ---------- *@
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Tell FriendDex about @friend.Name</h2>
        <textarea class="form-control mb-2" rows="3" @bind="note" @bind:event="oninput"
                  placeholder="e.g. Got into bouldering this spring, but hates crowded gyms. Birthday is March 4, 1999."
                  disabled="@thinking"></textarea>
        <button class="btn btn-primary" @onclick="AnalyzeNoteAsync" disabled="@(thinking || string.IsNullOrWhiteSpace(note))">
            @(thinking ? "Thinking..." : "Suggest updates")
        </button>
        @if (agentError != null)
        {
            <div class="alert alert-warning mt-3 mb-0">@agentError</div>
        }

        @if (proposal != null)
        {
            <div class="border rounded p-3 mt-3 bg-light">
                @if (proposal.IsEmpty)
                {
                    <p class="mb-2">No changes found in that note.</p>
                    <button class="btn btn-secondary btn-sm" @onclick="() => proposal = null">OK</button>
                }
                else
                {
                    <p class="fw-semibold mb-2">@proposal.Summary</p>
                    <ul class="mb-3">
                        @if (proposal.Gender != null) { <li>Gender → @proposal.Gender</li> }
                        @if (proposal.Birthday != null) { <li>Birthday → @proposal.Birthday</li> }
                        @if (proposal.FavoriteColor != null) { <li>Favorite color → @proposal.FavoriteColor</li> }
                        @foreach (var add in proposal.AddInterests)
                        {
                            <li>Add @(add.Kind == "Dislike" ? "dislike" : "like"): <strong>@add.Label</strong>@(add.Notes != null ? $" — {add.Notes}" : "")</li>
                        }
                        @foreach (var edit in proposal.UpdateInterests)
                        {
                            var label = friend.Interests.FirstOrDefault(i => i.Id == edit.Id)?.Label ?? $"#{edit.Id}";
                            <li>
                                Update <strong>@label</strong>:
                                @if (edit.Kind != null) { <span>now a @edit.Kind.ToLowerInvariant(). </span> }
                                @if (edit.Notes != null) { <span>notes → “@edit.Notes”</span> }
                            </li>
                        }
                        @foreach (var id in proposal.RemoveInterestIds)
                        {
                            var label = friend.Interests.FirstOrDefault(i => i.Id == id)?.Label ?? $"#{id}";
                            <li>Remove <strong>@label</strong></li>
                        }
                    </ul>
                    <button class="btn btn-success btn-sm" @onclick="ApplyProposalAsync">Apply changes</button>
                    <button class="btn btn-secondary btn-sm ms-1" @onclick="() => proposal = null">Discard</button>
                }
            </div>
        }
    </div>
</div>

@* ---------- Likes and dislikes ---------- *@
<div class="row g-4 mb-4">
    @foreach (var kind in new[] { InterestKind.Like, InterestKind.Dislike })
    {
        var items = friend.Interests.Where(i => i.Kind == kind).OrderBy(i => i.Label).ToList();
        <div class="col-md-6">
            <h2 class="h5">@(kind == InterestKind.Like ? "Likes" : "Dislikes")</h2>
            @if (items.Count == 0)
            {
                <p class="text-muted">None yet.</p>
            }
            <ul class="list-group">
                @foreach (var interest in items)
                {
                    <li class="list-group-item">
                        <button class="btn btn-link p-0 text-start fw-semibold" @onclick="() => ToggleInterest(interest)">
                            @interest.Label
                        </button>
                        @if (openInterestId == interest.Id)
                        {
                            @if (editingInterestId == interest.Id)
                            {
                                <input class="form-control form-control-sm mt-2" maxlength="50" @bind="editLabel" />
                                <textarea class="form-control form-control-sm mt-2" rows="3" @bind="editNotes" placeholder="Notes"></textarea>
                                <div class="mt-2">
                                    <button class="btn btn-primary btn-sm" @onclick="() => SaveInterestEditAsync(interest)" disabled="@string.IsNullOrWhiteSpace(editLabel)">Save</button>
                                    <button class="btn btn-secondary btn-sm ms-1" @onclick="() => editingInterestId = null">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <p class="mt-2 mb-2" style="white-space: pre-wrap">@(string.IsNullOrWhiteSpace(interest.Notes) ? "No notes." : interest.Notes)</p>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartEdit(interest)">Edit</button>
                                <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="() => FlipInterestAsync(interest)">
                                    Move to @(interest.Kind == InterestKind.Like ? "dislikes" : "likes")
                                </button>
                                <button class="btn btn-outline-danger btn-sm ms-1" @onclick="() => DeleteInterestAsync(interest)">Delete</button>
                            }
                        }
                    </li>
                }
            </ul>
        </div>
    }
</div>

@* ---------- Add interest by hand ---------- *@
<div class="card mb-4" style="max-width: 36rem">
    <div class="card-body">
        <h2 class="h6">Add an interest</h2>
        <EditForm Model="newInterest" OnValidSubmit="AddInterestAsync">
            <DataAnnotationsValidator />
            <div class="d-flex gap-2 mb-2">
                <InputText class="form-control" placeholder="Label, e.g. hiking" @bind-Value="newInterest.Label" />
                <InputSelect class="form-select" style="max-width: 9rem" @bind-Value="newInterest.Kind">
                    <option value="@InterestKind.Like">Like</option>
                    <option value="@InterestKind.Dislike">Dislike</option>
                </InputSelect>
            </div>
            <ValidationMessage For="() => newInterest.Label" />
            <InputTextArea class="form-control mb-2" rows="2" placeholder="Notes (optional)" @bind-Value="newInterest.Notes" />
            <button type="submit" class="btn btn-primary btn-sm">Add</button>
        </EditForm>
    </div>
</div>

<a href="/friends">← All friends</a>

@code {
    [Parameter] public int Id { get; set; }

    private const long MaxPhotoBytes = 2 * 1024 * 1024;

    private Friend? friend;
    private bool notFound;
    private bool confirmDelete;
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);

    private Interest newInterest = new();
    private int? openInterestId;
    private int? editingInterestId;
    private string editLabel = "";
    private string? editNotes;

    private string note = "";
    private bool thinking;
    private string? agentError;
    private FriendUpdateProposal? proposal;

    private string? photoError;

    private bool generating;
    private string? chibiError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        friend = await db.Friends.AsNoTracking().Include(f => f.Interests).FirstOrDefaultAsync(f => f.Id == Id);
        notFound = friend == null;
    }

    // Runs a change against a fresh tracked copy of the friend, saves, then reloads the page data.
    private async Task ChangeFriendAsync(Action<Friend> change)
    {
        await using var db = await Factory.CreateDbContextAsync();
        var tracked = await db.Friends.Include(f => f.Interests).FirstOrDefaultAsync(f => f.Id == Id);
        if (tracked == null) { notFound = true; return; }
        change(tracked);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    // ---- Interests ----

    private void ToggleInterest(Interest interest)
    {
        openInterestId = openInterestId == interest.Id ? null : interest.Id;
        editingInterestId = null;
    }

    private void StartEdit(Interest interest)
    {
        editingInterestId = interest.Id;
        editLabel = interest.Label;
        editNotes = interest.Notes;
    }

    private Task SaveInterestEditAsync(Interest interest)
    {
        editingInterestId = null;
        return ChangeFriendAsync(f =>
        {
            var target = f.Interests.FirstOrDefault(i => i.Id == interest.Id);
            if (target == null) return;
            target.Label = editLabel.Trim();
            target.Notes = string.IsNullOrWhiteSpace(editNotes) ? null : editNotes.Trim();
        });
    }

    private Task FlipInterestAsync(Interest interest) => ChangeFriendAsync(f =>
    {
        var target = f.Interests.FirstOrDefault(i => i.Id == interest.Id);
        if (target != null) target.Kind = target.Kind == InterestKind.Like ? InterestKind.Dislike : InterestKind.Like;
    });

    private Task DeleteInterestAsync(Interest interest)
    {
        openInterestId = null;
        return ChangeFriendAsync(f => f.Interests.RemoveAll(i => i.Id == interest.Id));
    }

    private async Task AddInterestAsync()
    {
        var toAdd = new Interest
        {
            Label = newInterest.Label.Trim(),
            Notes = string.IsNullOrWhiteSpace(newInterest.Notes) ? null : newInterest.Notes.Trim(),
            Kind = newInterest.Kind,
        };
        await ChangeFriendAsync(f => f.Interests.Add(toAdd));
        newInterest = new() { Kind = toAdd.Kind };
    }

    // ---- AI note ----

    private async Task AnalyzeNoteAsync()
    {
        if (friend == null || string.IsNullOrWhiteSpace(note)) return;
        thinking = true;
        agentError = null;
        proposal = null;
        try
        {
            proposal = await Agent.ProposeAsync(friend, note.Trim());
        }
        catch (Exception ex)
        {
            agentError = ex is InvalidOperationException
                ? ex.Message
                : $"Couldn't reach the AI. Check that ANTHROPIC_API_KEY is set, then try again. ({ex.GetType().Name})";
        }
        finally
        {
            thinking = false;
        }
    }

    private async Task ApplyProposalAsync()
    {
        if (proposal == null) return;
        var p = proposal;
        await ChangeFriendAsync(f => FriendNoteAgent.Apply(f, p));
        proposal = null;
        note = "";
    }

    // ---- Photo ----

    private async Task UploadPhotoAsync(InputFileChangeEventArgs e)
    {
        photoError = null;
        var file = e.File;
        string[] allowed = ["image/png", "image/jpeg", "image/webp", "image/gif"];
        if (!allowed.Contains(file.ContentType))
        {
            photoError = "Please choose a PNG, JPEG, WebP or GIF image.";
            return;
        }
        if (file.Size > MaxPhotoBytes)
        {
            photoError = "That image is over 2 MB. Please choose a smaller one.";
            return;
        }

        using var ms = new MemoryStream();
        await file.OpenReadStream(MaxPhotoBytes).CopyToAsync(ms);
        var bytes = ms.ToArray();
        await ChangeFriendAsync(f =>
        {
            f.Photo = bytes;
            f.PhotoContentType = file.ContentType;
        });
    }

    private Task RemovePhotoAsync() => ChangeFriendAsync(f =>
    {
        f.Photo = null;
        f.PhotoContentType = null;
    });

    // ---- AI chibi ----

    private async Task GenerateChibiAsync()
    {
        if (friend == null) return;
        generating = true;
        chibiError = null;
        try
        {
            var image = await ChibiAi.GenerateAsync(friend);
            await ChangeFriendAsync(f =>
            {
                f.Avatar = image.Bytes;
                f.AvatarContentType = image.ContentType;
                f.AvatarGeneratedAt = DateTime.UtcNow;
            });
        }
        catch (InvalidOperationException ex)
        {
            chibiError = ex.Message;
        }
        catch (Exception ex)
        {
            chibiError = $"Couldn't reach Gemini. Check your connection and try again. ({ex.GetType().Name})";
        }
        finally
        {
            generating = false;
        }
    }

    private Task ClearAvatarAsync() => ChangeFriendAsync(f =>
    {
        f.Avatar = null;
        f.AvatarContentType = null;
        f.AvatarGeneratedAt = null;
    });

    // ---- Delete ----

    private async Task DeleteFriendAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        var tracked = await db.Friends.FindAsync(Id);
        if (tracked != null)
        {
            db.Friends.Remove(tracked);
            await db.SaveChangesAsync();
        }
        Nav.NavigateTo("/friends");
    }
}
