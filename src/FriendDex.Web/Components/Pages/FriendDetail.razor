@page "/friends/{Id:int}"
@rendermode InteractiveServer
@using FriendDex.Web.Data
@using FriendDex.Web.Domain
@using FriendDex.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> Factory
@inject NavigationManager Nav
@inject FriendNoteAgent Agent
@inject ChibiGenerator ChibiAi

@if (notFound)
{
    <PageTitle>Friend not found</PageTitle>
    <section class="win">
        <h1 class="win-title">That friend isn't in your FriendDex</h1>
        <a class="px-btn" href="/friends">Back to friends</a>
    </section>
    return;
}
@if (friend == null)
{
    <section class="win"><p class="muted">Loading…</p></section>
    return;
}

@{
    var age = AgeCalculator.GetAge(friend.Birthday, today);
    var next = AgeCalculator.NextBirthday(friend.Birthday, today);
    var daysToBirthday = next.HasValue ? next.Value.DayNumber - today.DayNumber : (int?)null;
}

<PageTitle>@friend.Name · FriendDex</PageTitle>

<a class="back has-cursor" href="/friends">Friends</a>

@* ---------- Passport ---------- *@
<article class="win passport">
    <h1 class="passport-title">Friend passport</h1>

    <div class="passport-body">
        <div class="photo-col">
            <div class="photo-frame @(hopKey > 0 ? "hop" : "")" @key="hopKey">
                @if (friend.Avatar != null)
                {
                    <img class="sprite" src="/friends/@friend.Id/avatar?v=@friend.AvatarGeneratedAt?.Ticks"
                         alt="Pixel sprite of @friend.Name" width="192" height="192" />
                }
                else
                {
                    <Chibi Friend="friend" Size="170" />
                }
            </div>

            <div class="btn-row photo-actions">
                <button class="px-btn px-btn-sun px-btn-sm" @onclick="GenerateChibiAsync" disabled="@generating">
                    @(generating ? "Drawing…" : friend.Avatar == null ? "Make sprite" : "Redraw sprite")
                </button>
                <label class="px-btn px-btn-sm">
                    @(friend.Photo == null ? "Add photo" : "Change photo")
                    <InputFile OnChange="UploadPhotoAsync" accept="image/png,image/jpeg,image/webp,image/gif" class="visually-hidden" />
                </label>
            </div>
            <div class="btn-row">
                @if (friend.Avatar != null && !generating)
                {
                    <button class="text-btn" @onclick="ClearAvatarAsync">Use drawn version</button>
                }
                @if (friend.Photo != null)
                {
                    <button class="text-btn" @onclick="RemovePhotoAsync">Remove photo</button>
                }
            </div>
            @if (generating) { <p class="muted small">Drawing can take up to a minute.</p> }
            @if (chibiError != null) { <p class="error-text" role="alert">@chibiError</p> }
            @if (photoError != null) { <p class="error-text" role="alert">@photoError</p> }
        </div>

        <div class="info-col">
            <h2 class="friend-name">@friend.Name</h2>
            <p class="friend-level">@(age.HasValue ? $"Lv {age}" : "Level unknown")</p>

            <dl class="facts">
                <dt>Birthday</dt>
                <dd>@(friend.Birthday?.ToString("MMMM d, yyyy") ?? "Not set")</dd>
                <dt>Gender</dt>
                <dd>@(string.IsNullOrWhiteSpace(friend.Gender) ? "Not set" : friend.Gender)</dd>
                <dt>Favorite color</dt>
                <dd>
                    @if (friend.FavoriteColor != null)
                    {
                        <span class="swatch" style="background: @SafeSwatch(friend.FavoriteColor)"></span>
                        @friend.FavoriteColor
                    }
                    else { <span>Not set</span> }
                </dd>
            </dl>

            @if (daysToBirthday.HasValue)
            {
                <div class="stamp" aria-label="Next birthday">
                    <span class="stamp-big">@(daysToBirthday == 0 ? "Today!" : daysToBirthday == 1 ? "1 day" : $"{daysToBirthday} days")</span>
                    <span class="stamp-small">@(daysToBirthday == 0 ? "Happy birthday!" : $"until {next!.Value:MMM d}")</span>
                </div>
            }

            <div class="btn-row passport-actions">
                <a class="px-btn px-btn-sm" href="/friends/@friend.Id/edit">Edit details</a>
                @if (confirmDelete)
                {
                    <span class="confirm-text">Delete @friend.Name and everything about them?</span>
                    <button class="px-btn px-btn-berry px-btn-sm" @onclick="DeleteFriendAsync">Delete</button>
                    <button class="text-btn" @onclick="() => confirmDelete = false">Keep</button>
                }
                else
                {
                    <button class="text-btn" @onclick="() => confirmDelete = true">Delete friend</button>
                }
            </div>
        </div>
    </div>
</article>

@* ---------- Dialog box: tell FriendDex something ---------- *@
<section class="win dialog">
    <label class="dialog-prompt" for="note">What's new with @friend.Name?</label>
    <textarea id="note" class="px-textarea" rows="3" @bind="note" @bind:event="oninput" disabled="@thinking"
              placeholder="Got into bouldering this spring, but hates crowded gyms. Birthday is March 4, 1999."></textarea>
    <div class="btn-row dialog-actions">
        <button class="px-btn px-btn-sun" @onclick="AnalyzeNoteAsync" disabled="@(thinking || string.IsNullOrWhiteSpace(note))">
            @(thinking ? "Thinking…" : "Suggest updates")
        </button>
    </div>
    @if (agentError != null) { <p class="error-text" role="alert">@agentError</p> }

    @if (proposal != null)
    {
        <div class="choices" role="region" aria-label="Suggested updates">
            @if (proposal.IsEmpty)
            {
                <p>Nothing to update from that note.</p>
                <button class="px-btn px-btn-sm" @onclick="() => proposal = null">OK</button>
            }
            else
            {
                <p class="choices-summary">@proposal.Summary</p>
                <ul class="change-list">
                    @if (proposal.Gender != null) { <li>Gender: @proposal.Gender</li> }
                    @if (proposal.Birthday != null) { <li>Birthday: @proposal.Birthday</li> }
                    @if (proposal.FavoriteColor != null) { <li>Favorite color: @proposal.FavoriteColor</li> }
                    @foreach (var add in proposal.AddInterests)
                    {
                        <li><span class="tag @(add.Kind == "Dislike" ? "tag-dislike" : "tag-like")">@add.Label</span>
                            new @(add.Kind == "Dislike" ? "dislike" : "like")@(add.Notes != null ? $": {add.Notes}" : "")</li>
                    }
                    @foreach (var edit in proposal.UpdateInterests)
                    {
                        var label = friend.Interests.FirstOrDefault(i => i.Id == edit.Id)?.Label ?? $"#{edit.Id}";
                        <li>
                            <span class="tag">@label</span>
                            @if (edit.Kind != null) { <span> now a @edit.Kind.ToLowerInvariant().</span> }
                            @if (edit.Notes != null) { <span> Notes: @edit.Notes</span> }
                        </li>
                    }
                    @foreach (var id in proposal.RemoveInterestIds)
                    {
                        var label = friend.Interests.FirstOrDefault(i => i.Id == id)?.Label ?? $"#{id}";
                        <li><span class="tag">@label</span> removed</li>
                    }
                </ul>
                <div class="btn-row">
                    <button class="px-btn px-btn-leaf has-cursor" @onclick="ApplyProposalAsync">Apply changes</button>
                    <button class="px-btn has-cursor" @onclick="() => proposal = null">Discard</button>
                </div>
            }
        </div>
    }
</section>

@* ---------- Likes and dislikes ---------- *@
<div class="grid-2">
    @foreach (var kind in new[] { InterestKind.Like, InterestKind.Dislike })
    {
        var items = friend.Interests.Where(i => i.Kind == kind).OrderBy(i => i.Label).ToList();
        var open = items.FirstOrDefault(i => i.Id == openInterestId);
        <section class="win interests @(kind == InterestKind.Like ? "interests-like" : "interests-dislike")">
            <h2 class="win-title">@(kind == InterestKind.Like ? "Likes" : "Dislikes")</h2>
            @if (items.Count == 0)
            {
                <p class="muted">None yet. Add one below or tell FriendDex in the box above.</p>
            }
            <div class="tags">
                @foreach (var interest in items)
                {
                    <button class="tag @(kind == InterestKind.Like ? "tag-like" : "tag-dislike") @(openInterestId == interest.Id ? "tag-open" : "")"
                            aria-expanded="@(openInterestId == interest.Id ? "true" : "false")"
                            @onclick="() => ToggleInterest(interest)">
                        @interest.Label
                    </button>
                }
            </div>

            @if (open != null)
            {
                <div class="interest-detail">
                    @if (editingInterestId == open.Id)
                    {
                        <label class="field-label" for="edit-label">Label</label>
                        <input id="edit-label" class="px-input" maxlength="50" @bind="editLabel" />
                        <label class="field-label" for="edit-notes">Notes</label>
                        <textarea id="edit-notes" class="px-textarea" rows="3" @bind="editNotes"></textarea>
                        <div class="btn-row">
                            <button class="px-btn px-btn-leaf px-btn-sm" @onclick="() => SaveInterestEditAsync(open)" disabled="@string.IsNullOrWhiteSpace(editLabel)">Save</button>
                            <button class="text-btn" @onclick="() => editingInterestId = null">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <p class="notes">@(string.IsNullOrWhiteSpace(open.Notes) ? "No notes yet." : open.Notes)</p>
                        <div class="btn-row">
                            <button class="px-btn px-btn-sm" @onclick="() => StartEdit(open)">Edit</button>
                            <button class="px-btn px-btn-sm" @onclick="() => FlipInterestAsync(open)">
                                Move to @(open.Kind == InterestKind.Like ? "dislikes" : "likes")
                            </button>
                            <button class="text-btn" @onclick="() => DeleteInterestAsync(open)">Delete</button>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@* ---------- Add interest by hand ---------- *@
<section class="win add-interest">
    <h2 class="win-title">Add a like or dislike</h2>
    <EditForm Model="newInterest" OnValidSubmit="AddInterestAsync">
        <DataAnnotationsValidator />
        <div class="add-row">
            <div class="field grow">
                <label for="new-label">Label</label>
                <InputText id="new-label" class="px-input" placeholder="hiking" @bind-Value="newInterest.Label" />
                <ValidationMessage For="() => newInterest.Label" />
            </div>
            <div class="field">
                <label for="new-kind">Type</label>
                <InputSelect id="new-kind" class="px-select" @bind-Value="newInterest.Kind">
                    <option value="@InterestKind.Like">Like</option>
                    <option value="@InterestKind.Dislike">Dislike</option>
                </InputSelect>
            </div>
        </div>
        <div class="field">
            <label for="new-notes">Notes (optional)</label>
            <InputTextArea id="new-notes" class="px-textarea" rows="2" @bind-Value="newInterest.Notes" />
        </div>
        <button type="submit" class="px-btn px-btn-leaf">Add</button>
    </EditForm>
</section>

@code {
    [Parameter] public int Id { get; set; }

    private const long MaxPhotoBytes = 2 * 1024 * 1024;

    private Friend? friend;
    private bool notFound;
    private bool confirmDelete;
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);

    private Interest newInterest = new();
    private int? openInterestId;
    private int? editingInterestId;
    private string editLabel = "";
    private string? editNotes;

    private string note = "";
    private bool thinking;
    private string? agentError;
    private FriendUpdateProposal? proposal;

    private string? photoError;

    private bool generating;
    private int hopKey;
    private string? chibiError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        friend = await db.Friends.AsNoTracking().Include(f => f.Interests).FirstOrDefaultAsync(f => f.Id == Id);
        notFound = friend == null;
    }

    // Runs a change against a fresh tracked copy of the friend, saves, then reloads the page data.
    private async Task ChangeFriendAsync(Action<Friend> change)
    {
        await using var db = await Factory.CreateDbContextAsync();
        var tracked = await db.Friends.Include(f => f.Interests).FirstOrDefaultAsync(f => f.Id == Id);
        if (tracked == null) { notFound = true; return; }
        change(tracked);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    // ---- Interests ----

    private void ToggleInterest(Interest interest)
    {
        openInterestId = openInterestId == interest.Id ? null : interest.Id;
        editingInterestId = null;
    }

    private void StartEdit(Interest interest)
    {
        editingInterestId = interest.Id;
        editLabel = interest.Label;
        editNotes = interest.Notes;
    }

    private Task SaveInterestEditAsync(Interest interest)
    {
        editingInterestId = null;
        return ChangeFriendAsync(f =>
        {
            var target = f.Interests.FirstOrDefault(i => i.Id == interest.Id);
            if (target == null) return;
            target.Label = editLabel.Trim();
            target.Notes = string.IsNullOrWhiteSpace(editNotes) ? null : editNotes.Trim();
        });
    }

    private Task FlipInterestAsync(Interest interest) => ChangeFriendAsync(f =>
    {
        var target = f.Interests.FirstOrDefault(i => i.Id == interest.Id);
        if (target != null) target.Kind = target.Kind == InterestKind.Like ? InterestKind.Dislike : InterestKind.Like;
    });

    private Task DeleteInterestAsync(Interest interest)
    {
        openInterestId = null;
        return ChangeFriendAsync(f => f.Interests.RemoveAll(i => i.Id == interest.Id));
    }

    private async Task AddInterestAsync()
    {
        var toAdd = new Interest
        {
            Label = newInterest.Label.Trim(),
            Notes = string.IsNullOrWhiteSpace(newInterest.Notes) ? null : newInterest.Notes.Trim(),
            Kind = newInterest.Kind,
        };
        await ChangeFriendAsync(f => f.Interests.Add(toAdd));
        newInterest = new() { Kind = toAdd.Kind };
    }

    // ---- AI note ----

    private async Task AnalyzeNoteAsync()
    {
        if (friend == null || string.IsNullOrWhiteSpace(note)) return;
        thinking = true;
        agentError = null;
        proposal = null;
        try
        {
            proposal = await Agent.ProposeAsync(friend, note.Trim());
        }
        catch (Exception ex)
        {
            agentError = ex is InvalidOperationException
                ? ex.Message
                : $"Couldn't reach the AI. Check that ANTHROPIC_API_KEY is set, then try again. ({ex.GetType().Name})";
        }
        finally
        {
            thinking = false;
        }
    }

    private async Task ApplyProposalAsync()
    {
        if (proposal == null) return;
        var p = proposal;
        await ChangeFriendAsync(f => FriendNoteAgent.Apply(f, p));
        proposal = null;
        note = "";
    }

    // ---- Photo ----

    private async Task UploadPhotoAsync(InputFileChangeEventArgs e)
    {
        photoError = null;
        var file = e.File;
        string[] allowed = ["image/png", "image/jpeg", "image/webp", "image/gif"];
        if (!allowed.Contains(file.ContentType))
        {
            photoError = "Please choose a PNG, JPEG, WebP or GIF image.";
            return;
        }
        if (file.Size > MaxPhotoBytes)
        {
            photoError = "That image is over 2 MB. Please choose a smaller one.";
            return;
        }

        using var ms = new MemoryStream();
        await file.OpenReadStream(MaxPhotoBytes).CopyToAsync(ms);
        var bytes = ms.ToArray();
        await ChangeFriendAsync(f =>
        {
            f.Photo = bytes;
            f.PhotoContentType = file.ContentType;
        });
    }

    private Task RemovePhotoAsync() => ChangeFriendAsync(f =>
    {
        f.Photo = null;
        f.PhotoContentType = null;
    });

    // ---- AI chibi ----

    private async Task GenerateChibiAsync()
    {
        if (friend == null) return;
        generating = true;
        chibiError = null;
        try
        {
            var image = await ChibiAi.GenerateAsync(friend);
            await ChangeFriendAsync(f =>
            {
                f.Avatar = image.Bytes;
                f.AvatarContentType = image.ContentType;
                f.AvatarGeneratedAt = DateTime.UtcNow;
            });
            hopKey++;
        }
        catch (InvalidOperationException ex)
        {
            chibiError = ex.Message;
        }
        catch (Exception ex)
        {
            chibiError = $"Couldn't reach Gemini. Check your connection and try again. ({ex.GetType().Name})";
        }
        finally
        {
            generating = false;
        }
    }

    private Task ClearAvatarAsync() => ChangeFriendAsync(f =>
    {
        f.Avatar = null;
        f.AvatarContentType = null;
        f.AvatarGeneratedAt = null;
    });

    // Only plain color names or hex codes are used as CSS, so user text can't inject styles.
    private static string SafeSwatch(string color)
    {
        var c = color.Trim().ToLowerInvariant().Replace(" ", "");
        return System.Text.RegularExpressions.Regex.IsMatch(c, "^(#[0-9a-f]{3}|#[0-9a-f]{6}|[a-z]{3,20})$") ? c : "transparent";
    }

    // ---- Delete ----

    private async Task DeleteFriendAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        var tracked = await db.Friends.FindAsync(Id);
        if (tracked != null)
        {
            db.Friends.Remove(tracked);
            await db.SaveChangesAsync();
        }
        Nav.NavigateTo("/friends");
    }
}
