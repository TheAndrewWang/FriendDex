@page "/friends/new"
@page "/friends/{Id:int}/edit"
@rendermode InteractiveServer
@using FriendDex.Web.Data
@using FriendDex.Web.Domain
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> Factory
@inject NavigationManager Nav

<PageTitle>@(Id == null ? "New friend" : "Edit friend") · FriendDex</PageTitle>

@if (notFound)
{
    <section class="win">
        <h1 class="win-title">That friend isn't in your FriendDex</h1>
        <a class="px-btn" href="/friends">Back to friends</a>
    </section>
}
else if (friend == null)
{
    <section class="win"><p class="muted">Loading…</p></section>
}
else
{
    <section class="win edit-win">
        <h1 class="win-title">@(Id == null ? "New friend" : $"Edit {friend.Name}")</h1>
        <EditForm Model="friend" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="name">Name</label>
                <InputText id="name" class="px-input" @bind-Value="friend.Name" autocomplete="off" />
                <ValidationMessage For="() => friend.Name" />
            </div>
            <div class="field">
                <label for="birthday">Birthday</label>
                <InputDate id="birthday" class="px-input" @bind-Value="friend.Birthday" />
            </div>
            <div class="field">
                <label for="gender">Gender</label>
                <InputText id="gender" class="px-input" @bind-Value="friend.Gender" />
                <ValidationMessage For="() => friend.Gender" />
            </div>
            <div class="field">
                <label for="color">Favorite color</label>
                <InputText id="color" class="px-input" @bind-Value="friend.FavoriteColor" placeholder="teal, or a hex code like #3a7bd5" />
                <ValidationMessage For="() => friend.FavoriteColor" />
            </div>

            <div class="btn-row">
                <button type="submit" class="px-btn px-btn-leaf" disabled="@saving">@(Id == null ? "Add friend" : "Save changes")</button>
                <a class="text-btn" href="@(Id == null ? "/friends" : $"/friends/{Id}")">Cancel</a>
            </div>
        </EditForm>
    </section>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Friend? friend;
    private bool notFound;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (Id == null)
        {
            friend = new Friend();
        }
        else
        {
            await using var db = await Factory.CreateDbContextAsync();
            friend = await db.Friends.FindAsync(Id.Value);
            notFound = friend == null;
        }
    }

    private async Task SaveAsync()
    {
        if (friend == null) return;
        saving = true;

        friend.Name = friend.Name.Trim();
        friend.Gender = friend.Gender.Trim();
        friend.FavoriteColor = string.IsNullOrWhiteSpace(friend.FavoriteColor) ? null : friend.FavoriteColor.Trim();

        await using var db = await Factory.CreateDbContextAsync();
        if (Id == null)
        {
            db.Friends.Add(friend);
        }
        else
        {
            // The friend was loaded by a different (now disposed) context, so mark it as changed.
            db.Friends.Update(friend);
        }
        await db.SaveChangesAsync();

        Nav.NavigateTo($"/friends/{friend.Id}");
    }
}
