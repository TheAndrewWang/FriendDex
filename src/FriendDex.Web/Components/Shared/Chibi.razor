@using FriendDex.Web.Domain

@* Default pixel sprite (used until a sprite is generated with Gemini).
   Boy / girl / neutral picked from the gender field; shirt = favorite color. *@

<svg viewBox="-1 -1 @(width + 2) @(height + 2)" width="@Size" height="@Size"
     shape-rendering="crispEdges" role="img" aria-label="@AriaLabel">
    @foreach (var run in runs)
    {
        <rect x="@run.X" y="@run.Y" width="@run.Width" height="1" fill="@run.Fill" />
    }
</svg>

@code {
    [Parameter, EditorRequired] public Friend Friend { get; set; } = null!;
    [Parameter] public int Size { get; set; } = 200;

    private List<PixelSprites.Run> runs = [];
    private int width;
    private int height;
    private string AriaLabel = "";

    protected override void OnParametersSet()
    {
        var kind = PixelSprites.KindFor(Friend.Gender);
        var map = PixelSprites.MapFor(kind);
        width = map.Max(r => r.Length);
        height = map.Length;
        runs = PixelSprites.Runs(map, PixelSprites.PaletteFor(kind, Friend.FavoriteColor));
        AriaLabel = $"Pixel sprite of {Friend.Name}";
    }
}
